{
  "sourceLanguage" : "en",
  "strings" : {
    "duration.hoursAndMinutes" : {
      "comment" : "A duration with hours and minutes, such as 23 hours, 15 min. The first argument is the hours (23 hours), the second the minutes (15 min).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "duration.minutesShort" : {
      "comment" : "Minutes in a short duration, such as the 15 min in 23 hours, 15 min. No period after min.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min"
          }
        }
      }
    },
    "widget.month.a11y.goal %@ %@ %@" : {
      "comment" : "VoiceOver sentence for the month progress widget with a Monthly goal. Arguments: month, time logged, goal.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ af %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ of %@"
          }
        }
      }
    },
    "widget.month.a11y.nogoal %@ %@" : {
      "comment" : "VoiceOver sentence for the month progress widget without a goal or plans. Arguments: month, time logged.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        }
      }
    },
    "widget.month.a11y.plan %@ %@ %@" : {
      "comment" : "VoiceOver sentence for the month progress widget with plans and no goal. Arguments: month, time logged, planned time.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
