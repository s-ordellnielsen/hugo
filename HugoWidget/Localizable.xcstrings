        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@ of %@ planned"
          }
        }
      }
    },
    "widget.month.a11y.unavailable" : {
      "comment" : "VoiceOver sentence for the month progress widget when the app has not set it up yet.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugo-widget. Åbn Hugo for at sætte den op."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugo widget. Open Hugo to set it up."
          }
        }
      }
    },
    "widget.month.description" : {
      "comment" : "Description of the month progress widget in the widget gallery.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din tid denne måned mod dit mål."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your time this month against your goal."
          }
        }
      }
    },
